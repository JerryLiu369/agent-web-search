# Optional: required only when the ARK provider is enabled
# ARK_API_KEY=your_volcengine_ark_api_key

# Optional: Brave Search API key (https://api-dashboard.search.brave.com/)
# BRAVE_SEARCH_API_KEY=your_brave_search_api_key

# Optional: paid Exa Search API key; without it the free MCP endpoint is used
# EXA_API_KEY=your_exa_api_key

# Optional: comma- or newline-separated ARK keys
# ARK_API_KEY=key_one,key_two

# Optional provider controls
AGENT_WEB_SEARCH_PROVIDERS=ddgs,exa
AGENT_WEB_SEARCH_TIMEOUT=60
AGENT_WEB_SEARCH_ARK_MODELS=glm-5-2-260617,doubao-seed-2-1-turbo-260628,deepseek-v4-flash-ga-260731

# Optional providers (not enabled by default)
# GEMINI_API_KEY=your_google_ai_studio_key
# AGENT_WEB_SEARCH_GEMINI_MODELS=gemini-3.7-flash
# XAI_API_KEY=your_xai_api_key
# AGENT_WEB_SEARCH_GROK_MODELS=grok-4.6
# PARALLEL_API_KEY=your_parallel_api_key
# PERPLEXITY_API_KEY=your_perplexity_api_key
# TAVILY_API_KEY=your_tavily_api_key
# YDC_API_KEY=your_you_com_api_key
