# General settings
AGENT_WEB_SEARCH_PROVIDERS=ddgs,exa,parallel
AGENT_WEB_SEARCH_TIMEOUT=60

# Remote MCP over stateless Streamable HTTP
# AGENT_WEB_SEARCH_MCP_TRANSPORT=http
# AGENT_WEB_SEARCH_HTTP_HOST=0.0.0.0
# AGENT_WEB_SEARCH_HTTP_PORT=8000
# AGENT_WEB_SEARCH_AUTH_TOKEN=replace_with_at_least_32_random_characters
# AGENT_WEB_SEARCH_ALLOW_ANONYMOUS=false
# AGENT_WEB_SEARCH_HTTP_ALLOWED_HOSTS=search.example.com
# AGENT_WEB_SEARCH_HTTP_ALLOWED_ORIGINS=https://search.example.com

# Default providers: DDGS needs no configuration; Exa and Parallel use their
# free MCP endpoints when the corresponding paid API key is omitted.
# EXA_API_KEY=your_exa_api_key
# EXA_MCP_URL=https://mcp.exa.ai/mcp
# PARALLEL_API_KEY=your_parallel_api_key

# Model providers (add the provider name to AGENT_WEB_SEARCH_PROVIDERS)
# Experimental Codex Alpha Search gateway (API key only)
# AGENT_WEB_SEARCH_CODEX_ALPHA_ENDPOINT=https://gateway.example/v1/alpha/search
# AGENT_WEB_SEARCH_CODEX_ALPHA_API_KEY=
# AGENT_WEB_SEARCH_CODEX_ALPHA_MODEL=gpt-5.6-luna
# DeepSeek Anthropic Messages API web search
# DEEPSEEK_API_KEY=your_deepseek_api_key
# AGENT_WEB_SEARCH_DEEPSEEK_BASE_URL=https://api.deepseek.com/anthropic
# AGENT_WEB_SEARCH_DEEPSEEK_MODELS=deepseek-v4-flash
# ARK_API_KEY=key_one,key_two
# AGENT_WEB_SEARCH_ARK_MODELS=glm-5-2-260617,doubao-seed-2-1-turbo-260628,deepseek-v4-flash-ga-260731
# GEMINI_API_KEY=your_google_ai_studio_key
# AGENT_WEB_SEARCH_GEMINI_MODELS=gemini-3.7-flash
# XAI_API_KEY=your_xai_api_key
# AGENT_WEB_SEARCH_GROK_MODELS=grok-4.6
# Generic OpenAI Responses API web search
# AGENT_WEB_SEARCH_RESPONSES_BASE_URL=https://api.openai.com/v1
# AGENT_WEB_SEARCH_RESPONSES_API_KEY=
# AGENT_WEB_SEARCH_RESPONSES_MODELS=gpt-5-mini
# AGENT_WEB_SEARCH_RESPONSES_TOOL_TYPE=web_search
# AGENT_WEB_SEARCH_RESPONSES_TIMEOUT=60
# Generic Anthropic Messages API web search
# AGENT_WEB_SEARCH_MESSAGES_BASE_URL=https://api.anthropic.com
# AGENT_WEB_SEARCH_MESSAGES_API_KEY=
# AGENT_WEB_SEARCH_MESSAGES_MODELS=claude-3-7-sonnet-20250219,claude-3-5-haiku-20241022
# AGENT_WEB_SEARCH_MESSAGES_TOOL_TYPE=web_search_20250305
# AGENT_WEB_SEARCH_MESSAGES_TOOL_NAME=web_search
# AGENT_WEB_SEARCH_MESSAGES_TIMEOUT=60
# ZHIPU_CHAT_SEARCH_API_KEY=your_zhipu_chat_search_api_key
# AGENT_WEB_SEARCH_ZHIPU_CHAT_BASE_URL=https://open.bigmodel.cn
# AGENT_WEB_SEARCH_ZHIPU_CHAT_MODELS=glm-5.3-flash

# Agent search providers (add the provider name to AGENT_WEB_SEARCH_PROVIDERS)
# BRAVE_SEARCH_API_KEY=your_brave_search_api_key
# PERPLEXITY_API_KEY=your_perplexity_api_key
# TAVILY_API_KEY=your_tavily_api_key
# YDC_API_KEY=your_you_com_api_key
# ZHIPU_WEB_SEARCH_API_KEY=your_zhipu_web_search_api_key
# AGENT_WEB_SEARCH_ZHIPU_WEB_SEARCH_BASE_URL=https://open.bigmodel.cn
